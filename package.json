{
  "name": "my-web",
  "version": "0.1.0",
  "private": true,
  "description": "个人主页：作品展示 + 文档 + 在线小游戏（GitHub Pages）",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:game": "node --experimental-strip-types --test tests/jump-game.unit.test.ts",
    "test:content": "node --test tests/content-empty.unit.test.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "cannon-es": "^0.20.0",
    "front-matter": "^4.0.2",
    "markdown-it": "^15.0.2",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  }
}
